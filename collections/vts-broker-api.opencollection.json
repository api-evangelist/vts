{
  "opencollection": "1.0.0",
  "info": {
    "name": "VTS Lease Account Admin Broker API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Broker",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetches Broker Activities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vts.com/api/v1/broker/activities",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Fetches Broker Activities"
        },
        {
          "info": {
            "name": "Fetches broker agent users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vts.com/api/v1/broker/agents",
            "params": [
              {
                "name": "page[size]",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[before]",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[after]",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter[updated_since]",
                "value": "2021-03-15",
                "type": "query",
                "description": "Only display records that have been modified after the given date/timestamp. Should be in `YYYY-MM-DD HH:MM:SS` (ISO8601) format. (Hours, minutes, and seconds are optional.)"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Fetches broker agent users"
        },
        {
          "info": {
            "name": "Retrieves specific broker agent user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vts.com/api/v1/broker/agents/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieves specific broker agent user"
        },
        {
          "info": {
            "name": "Fetches Broker Assets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vts.com/api/v1/broker/assets",
            "params": [
              {
                "name": "page[size]",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[before]",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[after]",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter[updated_since]",
                "value": "2021-03-15",
                "type": "query",
                "description": "Only display records that have been modified after the given date/timestamp. Should be in `YYYY-MM-DD HH:MM:SS` (ISO8601) format. (Hours, minutes, and seconds are optional.)"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Fetches Broker Assets"
        },
        {
          "info": {
            "name": "Fetches Specific Broker Asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vts.com/api/v1/broker/assets/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Fetches Specific Broker Asset"
        },
        {
          "info": {
            "name": "Fetches Broker Availabilities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vts.com/api/v1/broker/availabilities",
            "params": [
              {
                "name": "page[size]",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[before]",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[after]",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter[updated_since]",
                "value": "2021-03-15",
                "type": "query",
                "description": "Only display records that have been modified after the given date/timestamp. Should be in `YYYY-MM-DD HH:MM:SS` (ISO8601) format. (Hours, minutes, and seconds are optional.)"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Fetches Broker Availabilities"
        }
      ]
    }
  ],
  "bundled": true
}